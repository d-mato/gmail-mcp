{
  "name": "@d-mato/gmail-mcp",
  "version": "0.1.9",
  "description": "MCP server for Gmail - search, read, archive, and manage your email",
  "type": "module",
  "bin": {
    "gmail-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "keywords": [
    "mcp",
    "gmail",
    "email",
    "model-context-protocol"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d-mato/gmail-mcp"
  },
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "googleapis": "173.0.0",
    "open": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
