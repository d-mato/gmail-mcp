{
  "name": "@d-mato/gmail-mcp",
  "version": "0.1.4",
  "description": "MCP server for Gmail - search, read, archive, and manage your email",
  "type": "module",
  "bin": {
    "gmail-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "keywords": [
    "mcp",
    "gmail",
    "email",
    "model-context-protocol"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d-mato/gmail-mcp"
  },
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "googleapis": "^171.4.0",
    "open": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^25.5.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.0"
  }
}
